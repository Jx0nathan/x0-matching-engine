# 复制到 /etc/matching-server.env 后按需修改

BIND=0.0.0.0:8080

# WAL 与快照目录。不可随实例销毁 —— 状态全在这里。
DATA_DIR=/var/lib/matching/data

# 每 N 条命令 fsync 一次；always=每条都刷（最安全最慢），never=不主动刷。
# EBS 上单次 fsync 约 0.5-1ms：always 会把吞吐压到千级/秒，64 则崩溃最多丢 63 条。
WAL_SYNC=64

# 交易对：symbol_id:base_currency:quote_currency，逗号分隔
SYMBOLS=1:0:1

RUST_LOG=info
